{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/guide_hook.py 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking the How-to is current"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/git_reminder.py 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
